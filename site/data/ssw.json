보통 수 주~두 달에 걸쳐 나타나므로 날짜를 늘려 다시 판정해야 한다.","발생 후 10일(끝 날짜까지) 평균: 북극진동(AO) -0.12 σ(평년 수준), 시베리아 고기압 +2.17 hPa(평년 수준), 한반도 기온 +0.53 °C(평년 수준), 동아시아 기온 +0.91 °C(다소 높음).","과거 이른 겨울(11~12월) 주 승온 5건 합성: 한반도 기온(추세 제거) 발생 후 0~30일 +1.47°C [+1.05, +1.88] (유의함), 31~60일 +0.29°C [-0.42, +1.00] (유의하지 않음). 이번 사례 0~10일 -0.37°C.","주의: 지표 영향은 보통 발생 후 수 주~두 달에 걸쳐 나타난다. 지금은 발생 후 10일 자료만 있으므로 위 '발생 후' 값은 지금까지 관측된 것이고, 과거 합성은 가능성의 범위일 뿐 예측이 아니다."]},"pch":{"start":"2026-07-25","levels":[10,30,50,100,150,200,250,300,500,700,850,1000],"v":[173,170,170,170,168,166,162,149,134,144,176,204,206,186,161,147,149,163,172,162,143,139,139,139,126,112,100,95,95,105,112,109,109,115,122,124,122,114,109,107,108,93,75,71,68,63,68,90,115,107,91,94,95,60,29,6,-10,-11,-3,4,16,50,72,89,95,89,87,89,86,64,37,20,22,38,50,31,4,-9,-6,9,19,31,43,30,5,-5,-5,-2,17,46,56,57,52,55,85,140,192,227,268,322,381,440,482,503,507,488,458,429,410,393,368,339,318,303,283,254,222,190,158,134,203,204,210,212,207,201,190,169,150,161,201,242,249,224,194,179,182,201,214,205,179,168,163,159,138,118,97,85,81,89,96,90,86,93,101,104,107,102,103,107,117,100,79,73,68,57,61,91,125,114,91,96,92,51,26,15,8,17,34,37,37,59,63,66,66,62,68,82,94,77,46,23,12,17,22,-5,-19,-15,-10,3,8,28,52,44,25,15,11,12,28,66,88,97,94,100,132,180,224,245,270,311,361,406,434,448,441,404,362,328,306,291,275,260,250,243,226,209,200,194,186,183,202,206,215,219,213,204,188,163,143,155,199,249,260,233,202,188,193,215,230,221,191,176,171,165,138,114,88,72,67,75,83,79,74,83,93,99,105,100,99,102,112,94,70,64,57,41,43,78,118,103,79,86,83,39,16,10,8,18,36,32,21,37,34,33,34,33,39,59,81,66,32,5,-13,-13,-6,-30,-35,-25,-21,-13,-12,8,41,42,28,22,15,9,25,69,94,108,112,116,146,187,224,238,253,278,315,348,366,376,372,332,288,255,235,224,211,199,193,191,179,168,168,172,173,182,165,176,192,200,196,182,158,128,105,119,174,240,258,228,193,180,187,211,229,222,189,174,170,161,125,94,64,46,39,50,60,57,50,64,79,88,98,89,82,81,92,70,44,39,31,6,3,50,100,77,50,63,64,19,1,3,3,12,30,15,-12,-4,-5